{
  "name": "trading-journal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "npm run clean:artifacts",
    "clean:artifacts": "rm -rf playwright-report test-results docs .gsd-backups .test*db .test*-shm .test*-wal .next/dev/logs .trading-journal/snapshots .trading-journal/playwright-*.db .trading-journal/playwright-*.db-wal .trading-journal/playwright-*.db-shm",
    "migrate": "drizzle-kit migrate",
    "accounting:migrate": "npx tsx scripts/accounting-migrate.ts migrate",
    "accounting:rebuild": "npx tsx scripts/accounting-migrate.ts rebuild",
    "accounting:reconcile": "npx tsx scripts/accounting-migrate.ts reconcile",
    "accounting:cutover-check": "npx tsx scripts/accounting-migrate.ts cutover-check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sudowealth/schwab-api": "^2.1.1",
    "@tanstack/react-table": "^8.21.3",
    "adm-zip": "^0.5.18",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "node-cron": "^4.6.0",
    "openai": "^6.45.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "^3.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
